# ============ Supabase (مطلوب) ============
# من: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# مفتاح anon (publishable): آمن للمتصفح لأن الحماية تتم عبر Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ============ الموقع ============
# يُستخدم في روابط تأكيد البريد واستعادة كلمة المرور
# محليًا: http://localhost:3000 — على Vercel: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============ بوابة الدفع ============
# لم يتم ربط أي بوابة. الدفع عند الاستلام فقط يعمل حاليًا.
# راجع التعليق في أعلى src/lib/payments.ts قبل تفعيل أي مفتاح.
# المفاتيح السرية لا توضع أبدًا في متغير يبدأ بـ NEXT_PUBLIC_
# PAYMENT_SECRET_KEY=

# ============ إنشاء الحسابات بدون بريد تأكيد (سيرفر فقط — سري) ============
# من: Supabase → Project Settings → API Keys → service_role (secret). لا تضعه أبدًا في متغير يبدأ بـ NEXT_PUBLIC_
# عند وجوده يُنشأ الحساب مؤكَّدًا ويدخل العميل مباشرة. بدونه يُستخدم بريد التأكيد العادي.
# SUPABASE_SERVICE_ROLE_KEY=
